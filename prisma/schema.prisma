// Prisma Schema for NexusAI Production Deployment
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  providers     AIProvider[]
  memories      UserMemory[]

  @@map("users")
}

model Conversation {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String      @default("New Chat")
  isPinned    Boolean     @default(false)
  personaId   String      @default("general")
  model       String      @default("gpt-4o-mini")
  temperature Float       @default(0.7)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  messages    Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String       // "user" | "assistant" | "system"
  content          String       @db.Text
  reasoningContent String?      @db.Text
  model            String?
  isError          Boolean      @default(false)
  tokensCount      Int?
  attachments      Json?        // Array of attached documents/images
  createdAt        DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

model AIProvider {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  baseUrl         String
  encryptedApiKey String   @db.Text
  model           String
  settings        Json?    // temperature, top_p, max_tokens, headers
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@map("ai_providers")
}

model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_memories")
}
